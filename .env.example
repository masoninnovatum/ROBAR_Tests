# Optional. Fixed name for the Template Management "create a new template" test.
# Leave unset/commented to generate a random "MBFlaUITestNNNNN" name each run (default behavior).
# ROBAR_TEMPLATE_NAME=

# Optional. Existing .btw file (from ROBAR_BTW_LIBRARY_DIR) to use for "browse for an existing
# template" flows (e.g. Replace Template). Leave unset to use the newest-modified .btw file instead.
# ROBAR_BTW_FILE=A1SuperTemplate_v0

# Optional. Folder of existing .btw files to pick from. Defaults to Mason's local template library.
# ROBAR_BTW_LIBRARY_DIR=
